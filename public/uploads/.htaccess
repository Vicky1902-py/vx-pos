# Nonaktifkan eksekusi skrip di folder uploads (Cegah Webshell & RCE)
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|sh|bash|pl|cgi|py|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
